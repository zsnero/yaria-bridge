{
  "manifest_version": 3,
  "name": "Yaria Bridge",
  "version": "0.1.1",
  "description": "Send videos and audio to the Yaria desktop app.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Yaria Bridge",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "scripts": [
      "src/shared/constants.js",
      "src/shared/browser-api.js",
      "src/shared/media.js",
      "src/shared/yaria-bridge.js",
      "src/background/background.js"
    ],
    "service_worker": "src/background/sw-loader.js"
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "webRequest",
    "contextMenus",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/content/detect.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "yaria@yaria.live",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["websiteContent", "browsingActivity"]
      }
    }
  }
}
